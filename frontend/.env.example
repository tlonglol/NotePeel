# Google OAuth (for Sign in with Google button)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Backend API base URL (no trailing slash). Leave unset for local dev
# (defaults to http://127.0.0.1:8000). In production set to your deployed
# backend, e.g. https://api.notepeel.example.com
VITE_API_URL=
